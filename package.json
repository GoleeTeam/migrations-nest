{
    "name": "@golee/migrations-nest",
    "version": "2.3.2",
    "description": "Simple database migration tools for mongodb and NestJS",
    "author": "Golee Team <dev@golee.it>",
    "license": "Apache-2.0",
    "main": "dist/index",
    "types": "dist/index",
    "keywords": [
        "nest",
        "mongodb",
        "mongo",
        "migrations"
    ],
    "scripts": {
        "test": "jest",
        "build": "rimraf dist && tsc --project tsconfig.build.json",
        "prepare": "husky",
        "prepublish": "npm run build",
        "lint": "eslint src --fix"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/GoleeTeam/migrations-nest.git"
    },
    "bugs": {
        "url": "https://github.com/GoleeTeam/migrations-nest/issues"
    },
    "homepage": "https://github.com/GoleeTeam/migrations-nest#readme",
    "peerDependencies": {
        "@nestjs/common": "^9.0.0 || ^10.0.0",
        "@nestjs/core": "^9.0.0 || ^10.0.0",
        "@nestjs/testing": "^9.0.0 || ^10.0.0",
        "mongodb": "^4.0.0 || ^5.0.0 || ^6.0.0"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^2",
        "@eslint/js": "^9",
        "@nestjs/common": "^10.4.5",
        "@nestjs/config": "^3.2.3",
        "@nestjs/core": "^10.4.5",
        "@nestjs/testing": "^10.4.5",
        "@types/jest": "29",
        "@types/node": "24.13.5",
        "eslint": "^9",
        "globals": "^15",
        "husky": "^9.1.6",
        "jest": "29",
        "lint-staged": "^15.2.10",
        "mongodb": "^6.9.0",
        "mongodb-memory-server": "^10.1.2",
        "prettier": "^3.3.3",
        "prettier-plugin-organize-imports": "^3",
        "prettier-plugin-tailwindcss": "^0",
        "rimraf": "^6.0.1",
        "ts-jest": "^29.2.5",
        "typescript": "^5.1.6",
        "typescript-eslint": "^8"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.*spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    },
    "lint-staged": {
        "*.{ts,tsx,js}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.json": "prettier --write"
    },
    "dependencies": {
        "glob": "^13.0.6"
    }
}
