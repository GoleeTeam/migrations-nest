{
    "name": "@golee/migrations-nest",
    "version": "2.4.1",
    "description": "Simple database migration tools for mongodb and NestJS",
    "author": "Golee Team <dev@golee.it>",
    "license": "Apache-2.0",
    "main": "dist/index",
    "types": "dist/index",
    "keywords": [
        "nest",
        "mongodb",
        "mongo",
        "migrations"
    ],
    "scripts": {
        "test": "jest",
        "build": "rimraf dist && tsc --project tsconfig.build.json",
        "prepare": "husky",
        "prepublish": "npm run build",
        "lint": "eslint src --fix"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/GoleeTeam/migrations-nest.git"
    },
    "bugs": {
        "url": "https://github.com/GoleeTeam/migrations-nest/issues"
    },
    "homepage": "https://github.com/GoleeTeam/migrations-nest#readme",
    "peerDependencies": {
        "@nestjs/common": "^9.0.0 || ^10.0.0",
        "@nestjs/core": "^9.0.0 || ^10.0.0",
        "@nestjs/testing": "^9.0.0 || ^10.0.0",
        "mongodb": "^4.0.0 || ^5.0.0 || ^6.0.0"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^2.1.4",
        "@eslint/js": "^9.39.5",
        "@nestjs/common": "^10.4.22",
        "@nestjs/config": "^3.3.0",
        "@nestjs/core": "^10.4.22",
        "@nestjs/testing": "^10.4.22",
        "@types/jest": "^29.5.14",
        "@types/node": "24.13.5",
        "eslint": "^9.39.5",
        "globals": "^15.15.0",
        "husky": "^9.1.7",
        "jest": "^29.7.0",
        "lint-staged": "^15.5.2",
        "mongodb": "^6.21.0",
        "mongodb-memory-server": "^10.4.3",
        "prettier": "^3.9.9",
        "prettier-plugin-organize-imports": "^3.2.4",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "rimraf": "^6.1.3",
        "ts-jest": "^29.4.13",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.70.1"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.*spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node",
        "testTimeout": 10000
    },
    "lint-staged": {
        "*.{ts,tsx,js}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.json": "prettier --write"
    },
    "dependencies": {
        "glob": "^13.0.6"
    }
}
